[Unit]
Description=AI Digital Consulting Center
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-consulting-center
EnvironmentFile=/opt/ai-consulting-center/.env
Environment=NODE_ENV=production
Environment=AI_CENTER_RUNTIME_OWNER=systemd
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /opt/ai-consulting-center/apps/server/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai-consulting-center/data

[Install]
WantedBy=default.target
